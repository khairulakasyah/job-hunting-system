APP_NAME="Job Hunter"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

# Used by password reset emails to build the frontend reset link
FRONTEND_URL=https://yourdomain.com

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jobhunter
DB_USERNAME=postgres
DB_PASSWORD=

# Mail — required for password reset emails to work
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# AI Cover Letter — Groq API key
AI_API_KEY=gsk_your_key_here

# Job Scraper service URL (Docker: http://scraper:5000)
SCRAPER_SERVICE_URL=http://scraper:5000
