APP_NAME="Job Hunter"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

# Used by password reset emails to build the frontend reset link
FRONTEND_URL=https://yourdomain.com

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jobhunter
DB_USERNAME=postgres
DB_PASSWORD=

# Mail — required for verification & password reset emails to work.
# Render free tier blocks outbound SMTP (ports 25/465/587), so use the Brevo
# HTTP API instead. Sign up at brevo.com, create an API key, and verify the
# sender address used in MAIL_FROM_ADDRESS.
MAIL_MAILER=brevo
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_ADDRESS=your@email.com
MAIL_FROM_NAME="${APP_NAME}"

# AI Cover Letter — Groq API key
AI_API_KEY=gsk_your_key_here

# Job Scraper service URL (Docker: http://scraper:5000)
SCRAPER_SERVICE_URL=http://scraper:5000
