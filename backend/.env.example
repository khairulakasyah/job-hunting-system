APP_NAME="Job Hunter"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

# Used by password reset emails to build the frontend reset link
FRONTEND_URL=https://yourdomain.com

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jobhunter
DB_USERNAME=postgres
DB_PASSWORD=

# Mail — required for verification & password reset emails to work.
# Render free tier blocks outbound SMTP (ports 25/465/587), so use Resend's HTTP
# API instead. Sign up at resend.com and create an API key. For testing you can
# send from Resend's shared sender (onboarding@resend.dev) to your own inbox with
# no DNS; for real sends to anyone you must verify a domain (DNS records).
MAIL_MAILER=resend
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"

# AI Cover Letter — Groq API key
AI_API_KEY=gsk_your_key_here

# Job Scraper service URL (Docker: http://scraper:5000)
SCRAPER_SERVICE_URL=http://scraper:5000
